@model CreateListingViewModel
@{
    ViewData["Title"] = "Post food";
}

<h1>Post food</h1>
<p class="text-muted">Enter the times in Lebanon time. A listing cannot be edited later. Cancel it and post again.</p>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WeightPerUnitKg" class="form-label"></label>
        <input asp-for="WeightPerUnitKg" class="form-control" />
        <span asp-validation-for="WeightPerUnitKg" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RequestWindowEndsAt" class="form-label"></label>
        <input asp-for="RequestWindowEndsAt" class="form-control" type="datetime-local" />
        <span asp-validation-for="RequestWindowEndsAt" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PickupFrom" class="form-label"></label>
        <input asp-for="PickupFrom" class="form-control" type="datetime-local" />
        <span asp-validation-for="PickupFrom" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PickupUntil" class="form-label"></label>
        <input asp-for="PickupUntil" class="form-control" type="datetime-local" />
        <span asp-validation-for="PickupUntil" class="text-danger"></span>
    </div>
    <fieldset class="mb-3">
        <legend class="form-label">Categories</legend>
        @foreach (var category in Model.Categories)
        {
            <div class="form-check">
                @if (Model.CategoryIds.Contains(category.Id))
                {
                    <input class="form-check-input" type="checkbox" name="categoryIds" value="@category.Id" id="category-@category.Id" checked />
                }
                else
                {
                    <input class="form-check-input" type="checkbox" name="categoryIds" value="@category.Id" id="category-@category.Id" />
                }
                <label class="form-check-label" for="category-@category.Id">@category.Name</label>
            </div>
        }
        <span asp-validation-for="CategoryIds" class="text-danger"></span>
    </fieldset>
    <button class="btn btn-success" type="submit">Post</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
