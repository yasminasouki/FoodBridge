@model CreateListingViewModel
@{
    ViewData["Title"] = "Post food";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">&larr; Dashboard</a>
</nav>

<section class="page-heading">
    <h1>Post food</h1>
    <p>Enter the times in Lebanon time. A listing cannot be edited later. Cancel it and post again.</p>
</section>
<form asp-action="Create" method="post" class="form-card form-wide">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <p class="form-section first">What are you sharing?</p>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="field-error"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="field-error"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="WeightPerUnitKg" class="form-label"></label>
            <input asp-for="WeightPerUnitKg" class="form-control" />
            <span asp-validation-for="WeightPerUnitKg" class="field-error"></span>
        </div>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label">Categories</legend>
        <div class="chip-group">
            @foreach (var category in Model.Categories)
            {
                <div class="chip-check">
                    @if (Model.CategoryIds.Contains(category.Id))
                    {
                        <input class="chip-input" type="checkbox" name="categoryIds" value="@category.Id" id="category-@category.Id" checked />
                    }
                    else
                    {
                        <input class="chip-input" type="checkbox" name="categoryIds" value="@category.Id" id="category-@category.Id" />
                    }
                    <label class="chip-label" for="category-@category.Id">@category.Name</label>
                </div>
            }
        </div>
        <span asp-validation-for="CategoryIds" class="field-error"></span>
    </fieldset>

    <p class="form-section">When can people get it?</p>
    <div class="mb-3">
        <label asp-for="RequestWindowEndsAt" class="form-label"></label>
        <input asp-for="RequestWindowEndsAt" class="form-control" type="datetime-local" />
        <span asp-validation-for="RequestWindowEndsAt" class="field-error"></span>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <label asp-for="PickupFrom" class="form-label"></label>
            <input asp-for="PickupFrom" class="form-control" type="datetime-local" />
            <span asp-validation-for="PickupFrom" class="field-error"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="PickupUntil" class="form-label"></label>
            <input asp-for="PickupUntil" class="form-control" type="datetime-local" />
            <span asp-validation-for="PickupUntil" class="field-error"></span>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-success" type="submit" data-loading-text="Posting...">Post listing</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
