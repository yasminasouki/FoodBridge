@model IReadOnlyList<AllocationGrant>
@{
    ViewData["Title"] = "Allocation result";
}

<h1>Who received the food</h1>
<p class="text-muted">Higher scores are served first. A score of zero still appears here when the request was not granted.</p>
<p><a asp-action="Index">Back to the dashboard</a></p>
@if (Model.Count == 0)
{
    <p class="text-muted">This listing has no requests.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Receiver</th>
                    <th>Asked</th>
                    <th>Given</th>
                    <th>Score</th>
                    <th>Status</th>
                    <th>Pickup code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model)
                {
                    <tr>
                        <td>@line.ReceiverName</td>
                        <td>@line.RequestedQuantity</td>
                        <td>@line.GrantedQuantity</td>
                        <td>@line.PriorityScore</td>
                        <td>@line.Status</td>
                        <td>@(string.IsNullOrWhiteSpace(line.PickupCode) ? "None" : line.PickupCode)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
