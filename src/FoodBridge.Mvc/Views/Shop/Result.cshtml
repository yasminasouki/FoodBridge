@model IReadOnlyList<AllocationGrant>
@{
    ViewData["Title"] = "Allocation result";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">&larr; Back to the dashboard</a>
</nav>

<section class="page-heading">
    <h1>Who received the food</h1>
    <p>Higher scores are served first. A score of zero still appears here when the request was not granted.</p>
</section>
@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon" aria-hidden="true">&#128237;</div>
        <p class="mb-0">This listing has no requests.</p>
    </div>
}
else
{
    <div class="table-responsive table-wrap">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Receiver</th>
                    <th>Asked</th>
                    <th>Given</th>
                    <th>Score</th>
                    <th>Status</th>
                    <th>Pickup code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model)
                {
                    <tr>
                        <td><strong>@line.ReceiverName</strong></td>
                        <td>@line.RequestedQuantity</td>
                        <td>@line.GrantedQuantity</td>
                        <td>@line.PriorityScore</td>
                        <td><span class="status status-@line.Status.ToLowerInvariant()">@line.Status</span></td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(line.PickupCode))
                            {
                                <span class="text-muted">None</span>
                            }
                            else
                            {
                                <span class="code-chip pickup-code">@line.PickupCode</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
