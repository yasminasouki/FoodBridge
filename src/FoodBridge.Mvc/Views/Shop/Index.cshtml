@model ListingPage
@{
    ViewData["Title"] = "Dashboard";
}

<section class="page-heading d-flex justify-content-between align-items-center">
    <h1>Shop dashboard</h1>
    <a class="btn btn-success" asp-action="Create">Post food</a>
</section>

<form asp-action="Collect" method="post" class="card listing-card mb-4">
    <div class="card-body">
        <h2 class="h5">Confirm a pickup</h2>
        <div class="row g-2 align-items-end">
            <div class="col-sm-6">
                <label class="form-label" for="pickupCode">Pickup code</label>
                <input class="form-control" id="pickupCode" name="pickupCode" />
            </div>
            <div class="col-sm-3">
                <button class="btn btn-success" type="submit">Confirm</button>
            </div>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <p class="text-muted">You have not posted any food yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Left</th>
                    <th>Status</th>
                    <th>Request until</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model.Items)
                {
                    <tr>
                        <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@listing.Id">@listing.Title</a></td>
                        <td>@listing.RemainingQuantity</td>
                        <td>@listing.Status</td>
                        <td>@LebanonTime.Format(listing.RequestWindowEndsAt)</td>
                        <td class="text-nowrap">
                            @if (listing.Status == "Open")
                            {
                                <form asp-action="Allocate" asp-route-id="@listing.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-success" type="submit">Allocate</button>
                                </form>
                            }
                            @if (listing.Status is "Open" or "Allocated")
                            {
                                <form asp-action="Close" asp-route-id="@listing.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Close</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
