@model Activity
@{
    ViewData["Title"] = "My Activity";
    var pending = Model.Reservations.Count(r => r.Status == "Pending");
}

<section class="page-heading">
    <h1>My Activity</h1>
    <p>Your requests, pickup codes and reliability in one place.</p>
</section>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="stat-tiles">
    @if (Model.ReliabilityScore is int score)
    {
        <div class="stat-tile stat-feature">
            <span class="stat-label">Reliability score</span>
            <span class="stat-value">@score</span>
            @if (Model.ReceiverType is not null)
            {
                <span class="stat-note">@Model.ReceiverType</span>
            }
            @if (Model.BlockedUntil is DateTime blocked)
            {
                <span class="stat-note text-danger">Blocked until @LebanonTime.Format(blocked)</span>
            }
        </div>
    }
    <div class="stat-tile">
        <span class="stat-label">Requests</span>
        <span class="stat-value">@Model.Requests.Count</span>
    </div>
    <div class="stat-tile">
        <span class="stat-label">Pickups waiting</span>
        <span class="stat-value">@pending</span>
    </div>
</div>

<h2 class="section-title">Requests</h2>
@if (Model.Requests.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon" aria-hidden="true">&#128230;</div>
        <p class="mb-3">No requests yet.</p>
        <a class="btn btn-outline-success btn-sm" asp-controller="Listings" asp-action="Index">Browse food</a>
    </div>
}
else
{
    <div class="table-responsive table-wrap mb-4">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Asked</th>
                    <th>Given</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td><a class="table-link" asp-controller="Listings" asp-action="Details" asp-route-id="@request.ListingId">@request.ListingTitle</a></td>
                        <td>@request.RequestedQuantity</td>
                        <td>@request.AllocatedQuantity</td>
                        <td><span class="status status-@request.Status.ToLowerInvariant()">@request.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="section-title">Pickup codes</h2>
@if (Model.Reservations.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon" aria-hidden="true">&#127915;</div>
        <p class="mb-0">No reservations yet. Your pickup codes will show up here.</p>
    </div>
}
else
{
    <div class="table-responsive table-wrap">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Quantity</th>
                    <th>Code</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Reservations)
                {
                    <tr>
                        <td><a class="table-link" asp-controller="Listings" asp-action="Details" asp-route-id="@reservation.ListingId">@reservation.ListingTitle</a></td>
                        <td>@reservation.Quantity</td>
                        <td>
                            <button type="button" class="code-chip pickup-code" data-copy="@reservation.PickupCode" title="Click to copy">@reservation.PickupCode</button>
                        </td>
                        <td><span class="status status-@reservation.Status.ToLowerInvariant()">@reservation.Status</span></td>
                        <td>
                            @if (reservation.Status == "Pending")
                            {
                                <form asp-action="Cancel" asp-route-id="@reservation.Id" method="post">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit" data-confirm="Cancel this reservation?">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
