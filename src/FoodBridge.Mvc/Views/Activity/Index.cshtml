@model Activity
@{
    ViewData["Title"] = "My Activity";
}

<h1>My Activity</h1>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.ReliabilityScore is int score)
{
    <section class="card listing-card mb-4">
        <div class="card-body">
            <p class="mb-1">Reliability score</p>
            <p class="display-6 mb-0">@score</p>
            @if (Model.ReceiverType is not null)
            {
                <p class="text-muted mb-0">@Model.ReceiverType</p>
            }
            @if (Model.BlockedUntil is DateTime blocked)
            {
                <p class="text-danger mb-0">Blocked until @LebanonTime.Format(blocked)</p>
            }
        </div>
    </section>
}

<h2 class="h4">Requests</h2>
@if (Model.Requests.Count == 0)
{
    <p class="text-muted">No requests yet.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Asked</th>
                    <th>Given</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@request.ListingId">@request.ListingTitle</a></td>
                        <td>@request.RequestedQuantity</td>
                        <td>@request.AllocatedQuantity</td>
                        <td>@request.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Pickup codes</h2>
@if (Model.Reservations.Count == 0)
{
    <p class="text-muted">No reservations yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Quantity</th>
                    <th>Code</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Reservations)
                {
                    <tr>
                        <td><a asp-controller="Listings" asp-action="Details" asp-route-id="@reservation.ListingId">@reservation.ListingTitle</a></td>
                        <td>@reservation.Quantity</td>
                        <td class="pickup-code">@reservation.PickupCode</td>
                        <td>@reservation.Status</td>
                        <td>
                            @if (reservation.Status == "Pending")
                            {
                                <form asp-action="Cancel" asp-route-id="@reservation.Id" method="post">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
