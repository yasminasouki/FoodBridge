@model IReadOnlyList<Notice>
@{
    ViewData["Title"] = "Updates";
}

<h1>Updates</h1>
<p class="text-muted">These stay on the website. FoodBridge does not send email or phone messages.</p>
@if (Model.Count == 0)
{
    <p class="text-muted">No updates yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var notice in Model)
        {
            <article class="list-group-item">
                <p class="mb-1">@notice.Message</p>
                <p class="text-muted mb-0">@LebanonTime.Format(notice.CreatedAt)</p>
            </article>
        }
    </div>
}
