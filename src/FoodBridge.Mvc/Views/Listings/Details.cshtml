@model ListingDetails
@{
    ViewData["Title"] = Model.Title;
    var canClaim = User.IsInRole("Receiver") || User.IsInRole("Ngo");
    var percentLeft = Model.OriginalQuantity > 0 ? (int)Math.Round(100.0 * Model.RemainingQuantity / Model.OriginalQuantity) : 0;
    var meterClass = Model.RemainingQuantity == 0 ? "meter-empty" : percentLeft <= 25 ? "meter-low" : "";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-action="Index">&larr; All listings</a>
</nav>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <article class="card listing-card detail-card">
            <div class="card-body">
                <p class="card-kicker mb-1">@Model.ShopName &middot; @Model.AreaName</p>
                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                    <h1 class="h2 mb-2">@Model.Title</h1>
                    <span class="status status-@Model.Status.ToLowerInvariant()">@Model.Status</span>
                </div>
                <p class="mb-3">
                    @foreach (var category in Model.Categories)
                    {
                        <span class="badge cat-pill me-1">@category</span>
                    }
                </p>

                <div class="meter-block">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="text-muted">Remaining</span>
                        <strong>@Model.RemainingQuantity of @Model.OriginalQuantity</strong>
                    </div>
                    <div class="meter" role="progressbar" aria-valuenow="@percentLeft" aria-valuemin="0" aria-valuemax="100" aria-label="Quantity remaining">
                        <span class="meter-fill @meterClass" style="width:@(percentLeft)%"></span>
                    </div>
                </div>

                <div class="info-tiles">
                    <div class="info-tile">
                        <span class="info-label">Weight</span>
                        <span class="info-value">@Model.WeightPerUnitKg.ToString("0.###") kg each</span>
                    </div>
                    <div class="info-tile">
                        <span class="info-label">Request until</span>
                        <span class="info-value">@LebanonTime.Format(Model.RequestWindowEndsAt)</span>
                    </div>
                    <div class="info-tile info-wide">
                        <span class="info-label">Pickup window</span>
                        <span class="info-value">@LebanonTime.Format(Model.PickupFrom) to @LebanonTime.Format(Model.PickupUntil)</span>
                    </div>
                    <div class="info-tile info-wide">
                        <span class="info-label">Pickup address</span>
                        <span class="info-value">@Model.Address</span>
                    </div>
                </div>
            </div>
        </article>
    </div>

    <div class="col-lg-5">
        <div class="action-column">
            @if (canClaim && Model.Status == "Open")
            {
                <form asp-action="RequestFood" asp-route-id="@Model.Id" method="post" class="card listing-card action-card">
                    <div class="card-body">
                        <h2 class="h5">Request this food</h2>
                        <p class="text-muted">An individual can ask for 2 units. An NGO can ask for 10.</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-5">
                                <label class="form-label" for="quantity">Quantity</label>
                                <input class="form-control" id="quantity" name="quantity" type="number" min="1" value="1" />
                            </div>
                            <div class="col-7">
                                <button class="btn btn-success w-100" type="submit" data-loading-text="Sending...">Send request</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            else if (canClaim && Model.Status == "Allocated" && Model.RemainingQuantity > 0)
            {
                <form asp-action="Reserve" asp-route-id="@Model.Id" method="post" class="card listing-card action-card">
                    <div class="card-body">
                        <h2 class="h5">Reserve leftovers</h2>
                        <p class="text-muted">First come, first served. Your pickup code appears on My Activity.</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-5">
                                <label class="form-label" for="quantity">Quantity</label>
                                <input class="form-control" id="quantity" name="quantity" type="number" min="1" max="@Model.RemainingQuantity" value="1" />
                            </div>
                            <div class="col-7">
                                <button class="btn btn-success w-100" type="submit" data-loading-text="Reserving...">Reserve</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            else if (canClaim && Model.Status == "Allocated" && Model.RemainingQuantity == 0)
            {
                <form asp-action="JoinWaitlist" asp-route-id="@Model.Id" method="post" class="card listing-card action-card is-waitlist">
                    <div class="card-body">
                        <h2 class="h5">Join the waitlist</h2>
                        <p class="text-muted">If someone cancels, the next person gets a notification. Press it to open this food. Missing that offer does not lower your reliability score.</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-5">
                                <label class="form-label" for="quantity">Quantity</label>
                                <input class="form-control" id="quantity" name="quantity" type="number" min="1" value="1" />
                            </div>
                            <div class="col-7">
                                <button class="btn btn-success w-100" type="submit" data-loading-text="Joining...">Join waitlist</button>
                            </div>
                        </div>
                    </div>
                </form>
            }
            else if (User.Identity?.IsAuthenticated != true && (Model.Status == "Open" || Model.Status == "Allocated"))
            {
                <div class="card listing-card action-card">
                    <div class="card-body">
                        <h2 class="h5">Want this food?</h2>
                        <p class="text-muted">Log in to request or reserve it.</p>
                        <div class="d-flex gap-2">
                            <a class="btn btn-success" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn btn-outline-success" asp-controller="Account" asp-action="Register">Register</a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card listing-card action-card">
                    <div class="card-body">
                        <h2 class="h5">Not available</h2>
                        <p class="text-muted mb-0">This listing is @Model.Status.ToLowerInvariant() and cannot be requested right now.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
