@model ListingDetails
@{
    ViewData["Title"] = Model.Title;
    var canClaim = User.IsInRole("Receiver") || User.IsInRole("Ngo");
}

<article class="card listing-card">
    <div class="card-body">
        <p class="text-muted mb-1">@Model.ShopName · @Model.AreaName</p>
        <h1 class="h2">@Model.Title</h1>
        <p>
            @foreach (var category in Model.Categories)
            {
                <span class="badge text-bg-light border me-1">@category</span>
            }
            <span class="badge text-bg-success">@Model.Status</span>
        </p>
        <dl class="row mb-0">
            <dt class="col-sm-3">Left</dt>
            <dd class="col-sm-9">@Model.RemainingQuantity of @Model.OriginalQuantity</dd>
            <dt class="col-sm-3">Weight</dt>
            <dd class="col-sm-9">@Model.WeightPerUnitKg.ToString("0.###") kg each</dd>
            <dt class="col-sm-3">Pickup</dt>
            <dd class="col-sm-9">@Model.Address</dd>
            <dt class="col-sm-3">Request until</dt>
            <dd class="col-sm-9">@LebanonTime.Format(Model.RequestWindowEndsAt)</dd>
            <dt class="col-sm-3">Pickup window</dt>
            <dd class="col-sm-9">@LebanonTime.Format(Model.PickupFrom) to @LebanonTime.Format(Model.PickupUntil)</dd>
        </dl>
    </div>
</article>

@if (canClaim && Model.Status == "Open")
{
    <form asp-action="RequestFood" asp-route-id="@Model.Id" method="post" class="card listing-card mt-3">
        <div class="card-body">
            <h2 class="h5">Request this food</h2>
            <p class="text-muted">An individual can ask for 2 units. An NGO can ask for 10.</p>
            <div class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label" for="quantity">Quantity</label>
                    <input class="form-control" id="quantity" name="quantity" type="number" min="1" value="1" />
                </div>
                <div class="col-sm-4">
                    <button class="btn btn-success" type="submit">Send request</button>
                </div>
            </div>
        </div>
    </form>
}
else if (canClaim && Model.Status == "Allocated" && Model.RemainingQuantity > 0)
{
    <form asp-action="Reserve" asp-route-id="@Model.Id" method="post" class="card listing-card mt-3">
        <div class="card-body">
            <h2 class="h5">Reserve leftovers</h2>
            <p class="text-muted">First come, first served. Your pickup code appears on My Activity.</p>
            <div class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label" for="quantity">Quantity</label>
                    <input class="form-control" id="quantity" name="quantity" type="number" min="1" max="@Model.RemainingQuantity" value="1" />
                </div>
                <div class="col-sm-4">
                    <button class="btn btn-success" type="submit">Reserve</button>
                </div>
            </div>
        </div>
    </form>
}
else if (User.Identity?.IsAuthenticated != true && (Model.Status == "Open" || Model.Status == "Allocated"))
{
    <p class="mt-3"><a asp-controller="Account" asp-action="Login">Log in</a> to request or reserve this food.</p>
}
