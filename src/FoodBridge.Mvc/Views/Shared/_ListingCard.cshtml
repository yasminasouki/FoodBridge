@model ListingSummary
<article class="card listing-card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between gap-2">
            <h2 class="h5 card-title mb-1">@Model.Title</h2>
            <span class="badge text-bg-success">@Model.RemainingQuantity left</span>
        </div>
        <p class="text-muted mb-2">@Model.ShopName · @Model.AreaName</p>
        <p class="mb-2">
            @foreach (var category in Model.Categories)
            {
                <span class="badge text-bg-light border me-1">@category</span>
            }
        </p>
        <p class="small mb-3">Request until @LebanonTime.Format(Model.RequestWindowEndsAt)</p>
        <a class="btn btn-outline-success mt-auto" asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id">View</a>
    </div>
</article>
