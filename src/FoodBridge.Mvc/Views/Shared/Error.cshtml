@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Error";
}

<section class="status-page">
    <div class="status-icon" aria-hidden="true">&#9888;&#65039;</div>
    <h1>Something went wrong</h1>
    <p>The page could not be completed. Please try again in a moment.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }

    <div class="d-flex gap-2 justify-content-center flex-wrap">
        <a class="btn btn-success" asp-controller="Listings" asp-action="Index">Back to listings</a>
        <a class="btn btn-outline-secondary" href="javascript:history.back()">Go back</a>
    </div>

    @if (Env.IsDevelopment())
    {
        <p class="dev-note">Development mode: detailed exception pages are enabled only when <code>ASPNETCORE_ENVIRONMENT</code> is <code>Development</code>. Never enable it for a deployed app.</p>
    }
</section>
