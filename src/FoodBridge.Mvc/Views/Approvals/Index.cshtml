@model IReadOnlyList<PendingApproval>
@{
    ViewData["Title"] = "Approvals";
}

<section class="page-heading d-flex justify-content-between align-items-end flex-wrap gap-2">
    <div>
        <h1>Waiting for approval</h1>
        <p class="mb-0">Review new shops and NGOs before they can start.</p>
    </div>
    <span class="count-pill">@Model.Count pending</span>
</section>
@if (Model.Count == 0)
{
    <div class="empty-state text-center">
        <div class="empty-icon" aria-hidden="true">&#9989;</div>
        <h2 class="h5">All caught up</h2>
        <p class="mb-0">No shops or NGOs are waiting.</p>
    </div>
}
else
{
    <div class="table-responsive table-wrap">
        <table class="table data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Kind</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(item.Name) ? "?" : item.Name.Trim()[0].ToString().ToUpperInvariant())</span>
                                <strong>@item.Name</strong>
                            </div>
                        </td>
                        <td>@item.Email</td>
                        <td><span class="badge cat-pill">@item.Kind</span></td>
                        <td>
                            <form asp-action="Approve" method="post" class="d-flex justify-content-end">
                                <input type="hidden" name="userId" value="@item.UserId" />
                                <button class="btn btn-sm btn-success" type="submit" data-loading-text="Approving...">Approve</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
